{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/atod-dialogue.schema.json",
  "title": "ATOD dialogue collection",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "complexity_class",
      "dialogue_id",
      "dialogue_index",
      "goal_list",
      "metadata",
      "turns"
    ],
    "properties": {
      "complexity_class": {
        "enum": ["medium", "complex"]
      },
      "dialogue_id": {
        "type": "string",
        "minLength": 1
      },
      "dialogue_index": {
        "type": "integer"
      },
      "goal_list": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "domain",
            "intent",
            "content",
            "core_content",
            "status",
            "dependencies"
          ],
          "properties": {
            "id": {"type": "string"},
            "domain": {"type": "string"},
            "intent": {"type": "string"},
            "content": {"type": "string"},
            "core_content": {"type": "string"},
            "status": {
              "enum": [
                "open",
                "pending",
                "completed",
                "failed",
                "abandoned",
                "not_mentioned"
              ]
            },
            "dependencies": {
              "type": "array",
              "items": {"type": "string"}
            },
            "slots": {"type": "array"},
            "slot_values": {"type": "object"},
            "status_history": {"type": "array"},
            "first_mentioned_turn": {
              "type": ["integer", "null"]
            },
            "completion_turn": {
              "type": ["integer", "null"]
            }
          },
          "additionalProperties": true
        }
      },
      "turns": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["speaker", "utterance", "turn_id"],
          "properties": {
            "speaker": {"enum": ["USER", "SYSTEM"]},
            "utterance": {"type": "string"},
            "turn_id": {"type": "integer"},
            "all_goals": {"type": "array"},
            "goal_status_changes": {"type": "array"}
          },
          "additionalProperties": true
        }
      },
      "metadata": {
        "type": "object",
        "required": [
          "num_goals",
          "estimated_turns",
          "async_execution",
          "interleaving",
          "proactivity"
        ],
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
